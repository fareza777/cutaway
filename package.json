{
  "name": "cutaway",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.12",
    "expo-asset": "~57.0.10",
    "expo-constants": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-gl": "~57.0.2",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/three": "^0.185.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web",
    "build:models": "node tools/build-models.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node tools/validate-content.mjs",
    "check": "npm run typecheck && npm run validate && npm run smoke && npm run test:rice-cooker && npm run test:localization",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/smoke-test.mts",
    "test:rice-cooker": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/rice-cooker-test.mts",
    "test:localization": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/catalog-quality-test.mts --localization-only",
    "test:catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/catalog-quality-test.mts",
    "build:brand": "node tools/build-brand.mjs",
    "preview": "node tools/preview-server.mjs",
    "verify:apk": "node tools/verify-apk.mjs",
    "build:apk": "bash tools/build-apk.sh"
  },
  "private": true
}
