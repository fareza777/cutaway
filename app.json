{
  "expo": {
    "name": "Cutaway: How Things Work 3D",
    "slug": "cutaway",
    "version": "0.23.1",
    "orientation": "portrait",
    "scheme": "cutaway",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "android": {
      "package": "com.cutaway.explorer",
      "versionCode": 29,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#07090D"
      },
      "permissions": [],
      "backgroundColor": "#F4F5F8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cutaway.explorer"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#F4F5F8"
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/models"
          ]
        }
      ],
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6279186647593327~8674849287",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# expo-gl GLView is instantiated reflectively by expo-modules\n-keep class expo.modules.gl.** { *; }\n"
          }
        }
      ]
    ],
    "react-native-google-mobile-ads": {
      "android_app_id": "ca-app-pub-6279186647593327~8674849287"
    },
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#F4F5F8",
    "extra": {
      "privacyPolicyUrl": "https://fareza777.github.io/cutaway/privacy-policy.html",
      "admob": {
        "bannerUnitId": "ca-app-pub-6279186647593327/5209257311",
        "interstitialUnitId": "ca-app-pub-6279186647593327/7776650259",
        "rewardedUnitId": "ca-app-pub-6279186647593327/7551778147"
      }
    }
  }
}
